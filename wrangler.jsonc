{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "parking-jawn",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "parking-jawn-staging",
      "workers_dev": true,
      "vars": {
        "INDEXABLE": "false"
      }
    },
    "production": {
      "name": "parking-jawn-production",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "parkingjawn.com",
          "custom_domain": true
        },
        {
          "pattern": "www.parkingjawn.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "INDEXABLE": "true"
      }
    }
  }
}
